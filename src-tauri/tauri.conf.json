{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "WebSocket Mock",
  "version": "0.1.0",
  "identifier": "dev.codex.websocket-mock",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WebSocket Mock",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}

